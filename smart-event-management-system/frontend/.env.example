# EventSphere - Frontend Environment Template
# Production API URL (set in Vercel / Render environment variables)
# Example: https://eventsphere-backend.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com

# Firebase Web Authentication (copy values from Firebase Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=eventsphere-1243c
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
