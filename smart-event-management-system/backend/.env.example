# ===================================================================
# EventSphere - Backend Production & Development Environment Template
# ===================================================================
# In production (Render), set these in the Render Dashboard Environment Variables.
# In local development, copy this file to ".env" and fill in your values.

# -------------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------------
APP_NAME=EventSphere
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# -------------------------------------------------------------------
# Frontend & Backend URLs (Localhost Development)
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# -------------------------------------------------------------------
# Security / JWT
# -------------------------------------------------------------------
# Generate a strong secret key (e.g. openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_32_byte_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Database (Firebase Firestore)
# -------------------------------------------------------------------
# Option A (Recommended for Render): Individual Firebase Environment Variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note for Render: Paste the private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Option B (Alternative for local dev or Render Secret Files):
# FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# -------------------------------------------------------------------
# Email Delivery (Option 1: Resend HTTP API - Recommended for Cloud/Render)
# -------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -------------------------------------------------------------------
# Email Delivery (Option 2: SMTP / Gmail)
# -------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, use an App Password generated from Google Account Security
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_NAME=EventSphere
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=True

# -------------------------------------------------------------------
# OTP Settings
# -------------------------------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -------------------------------------------------------------------
# Uploads
# -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# -------------------------------------------------------------------
# CORS Configuration (Localhost)
# -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# -------------------------------------------------------------------
# Demo/Test Users
# -------------------------------------------------------------------
# Set true only when you want the demo accounts created/updated on startup.
SEED_TEST_USERS=false
