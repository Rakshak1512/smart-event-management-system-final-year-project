# ------------------------------------------------------------------
# Smart Event Management System - Backend Environment Configuration
# Copy this file to ".env" and fill in real values before running.
# ------------------------------------------------------------------

# App
APP_NAME="EventSphere"
APP_ENV=development
DEBUG=True
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Security / JWT
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Firebase Firestore)
# Option 1: Provide path to service account json file
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json
# Option 2: Provide individual Firebase credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional Firebase Storage Bucket (defaults to <project_id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# Option 3: Local Firestore Emulator (for local offline testing without credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Email Delivery (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smart.event.system2026@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME="EventSphere"
SMTP_FROM_EMAIL=smart.event.system2026@gmail.com
SMTP_USE_TLS=True

# OTP
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# CORS (Frontend Origins only - do NOT include backend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
